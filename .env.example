# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=your-16-char-app-password
# Optional From header (defaults to SMTP_USER):
# SMTP_FROM=your-sender@gmail.com
